# srl2: Nokia SR Linux IS-IS speaker (BGP-LS is not on 7220 IXR-D)
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "IS-IS to r8"
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.1.80.2/30
set / interface ethernet-1/1 subinterface 0 ipv6 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv6 address fd00:1:80::2/64
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "IS-IS to srl1"
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.1.90.2/30
set / interface ethernet-1/2 subinterface 0 ipv6 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv6 address fd00:1:90::2/64
set / interface system0 admin-state enable
set / interface system0 description "system loopback"
set / interface system0 subinterface 0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.0.10/32
set / interface system0 subinterface 0 ipv6 admin-state enable
set / interface system0 subinterface 0 ipv6 address fd00:255::10/128
set / network-instance default router-id 10.255.0.10
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface system0.0
set / network-instance default protocols isis instance 1 admin-state enable
set / network-instance default protocols isis instance 1 level-capability L2
set / network-instance default protocols isis instance 1 net [49.0001.0000.0000.0010.00]
set / network-instance default protocols isis instance 1 hello-padding disable
set / network-instance default protocols isis instance 1 ipv4-unicast admin-state enable
set / network-instance default protocols isis instance 1 ipv6-unicast admin-state enable
set / network-instance default protocols isis instance 1 ipv6-unicast multi-topology false
set / network-instance default protocols isis instance 1 level 2 metric-style wide
set / network-instance default protocols isis instance 1 interface ethernet-1/1.0 admin-state enable
set / network-instance default protocols isis instance 1 interface ethernet-1/1.0 circuit-type point-to-point
set / network-instance default protocols isis instance 1 interface ethernet-1/1.0 ipv4-unicast admin-state enable
set / network-instance default protocols isis instance 1 interface ethernet-1/1.0 ipv6-unicast admin-state enable
set / network-instance default protocols isis instance 1 interface ethernet-1/1.0 level 2 metric 25
set / network-instance default protocols isis instance 1 interface ethernet-1/1.0 level 2 timers hello-interval 1
set / network-instance default protocols isis instance 1 interface ethernet-1/1.0 level 2 timers hello-multiplier 3
set / network-instance default protocols isis instance 1 interface ethernet-1/2.0 admin-state enable
set / network-instance default protocols isis instance 1 interface ethernet-1/2.0 circuit-type point-to-point
set / network-instance default protocols isis instance 1 interface ethernet-1/2.0 ipv4-unicast admin-state enable
set / network-instance default protocols isis instance 1 interface ethernet-1/2.0 ipv6-unicast admin-state enable
set / network-instance default protocols isis instance 1 interface ethernet-1/2.0 level 2 metric 20
set / network-instance default protocols isis instance 1 interface ethernet-1/2.0 level 2 timers hello-interval 1
set / network-instance default protocols isis instance 1 interface ethernet-1/2.0 level 2 timers hello-multiplier 3
set / network-instance default protocols isis instance 1 interface system0.0 admin-state enable
set / network-instance default protocols isis instance 1 interface system0.0 passive true
