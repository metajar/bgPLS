# srl2: Nokia SR Linux IS-IS speaker and BGP-LS producer
interface ethernet-1/1 {
    admin-state enable
    description "BGP-LS to collector"
    subinterface 0 {
        admin-state enable
        ipv4 {
            admin-state enable
            address 10.0.4.2/30 {
            }
        }
    }
}
interface ethernet-1/2 {
    admin-state enable
    description "IS-IS to r8"
    subinterface 0 {
        admin-state enable
        ipv4 {
            admin-state enable
            address 10.1.80.2/30 {
            }
        }
        ipv6 {
            admin-state enable
            address fd00:1:80::2/64 {
            }
        }
    }
}
interface ethernet-1/3 {
    admin-state enable
    description "IS-IS to srl1"
    subinterface 0 {
        admin-state enable
        ipv4 {
            admin-state enable
            address 10.1.90.2/30 {
            }
        }
        ipv6 {
            admin-state enable
            address fd00:1:90::2/64 {
            }
        }
    }
}
interface lo0 {
    admin-state enable
    description "system loopback"
    subinterface 0 {
        admin-state enable
        ipv4 {
            admin-state enable
            address 10.255.0.10/32 {
            }
        }
        ipv6 {
            admin-state enable
            address fd00:255::10/128 {
            }
        }
    }
}
routing-policy {
    policy accept-bgpls {
        default-action {
            accept {
            }
        }
    }
}
network-instance default {
    router-id 10.255.0.10
    interface ethernet-1/1.0 {
    }
    interface ethernet-1/2.0 {
    }
    interface ethernet-1/3.0 {
    }
    interface lo0.0 {
    }
    traffic-engineering {
        autonomous-system 65000
        ipv4-te-router-id 10.255.0.10
        ipv6-te-router-id fd00:255::10
        interface to-r8 {
            interface-ref {
                interface ethernet-1/2
                subinterface 0
            }
        }
        interface to-srl1 {
            interface-ref {
                interface ethernet-1/3
                subinterface 0
            }
        }
    }
    protocols {
        isis {
            instance 1 {
                admin-state enable
                level-capability L2
                net [ 49.0001.0000.0000.0010.00 ]
                ipv4-unicast {
                    admin-state enable
                }
                ipv6-unicast {
                    admin-state enable
                    multi-topology true
                }
                traffic-engineering {
                    advertisement true
                }
                te-database-install {
                    bgp-ls {
                        igp-identifier 1
                    }
                }
                interface ethernet-1/2.0 {
                    admin-state enable
                    circuit-type point-to-point
                    ipv4-unicast {
                        admin-state enable
                    }
                    ipv6-unicast {
                        admin-state enable
                    }
                    level 2 {
                        metric 25
                        timers {
                            hello-interval 1
                            hello-multiplier 3
                        }
                    }
                }
                interface ethernet-1/3.0 {
                    admin-state enable
                    circuit-type point-to-point
                    ipv4-unicast {
                        admin-state enable
                    }
                    ipv6-unicast {
                        admin-state enable
                    }
                    level 2 {
                        metric 20
                        timers {
                            hello-interval 1
                            hello-multiplier 3
                        }
                    }
                }
                interface lo0.0 {
                    admin-state enable
                    passive true
                }
            }
        }
        bgp {
            admin-state enable
            autonomous-system 65000
            router-id 10.255.0.10
            afi-safi ipv4-unicast {
                admin-state disable
            }
            afi-safi link-state {
                admin-state enable
                export-policy [
                    accept-bgpls
                ]
            }
            group bgpls {
                admin-state enable
                peer-as 65000
                export-policy [
                    accept-bgpls
                ]
                afi-safi ipv4-unicast {
                    admin-state disable
                }
                afi-safi link-state {
                    admin-state enable
                    export-policy [
                        accept-bgpls
                    ]
                    default-export-policy accept
                }
                transport {
                    local-address 10.0.4.2
                }
                timers {
                    hold-time 9
                    keepalive-interval 3
                }
            }
            neighbor 10.0.4.1 {
                admin-state enable
                peer-group bgpls
                description "bgPLS collector"
            }
        }
    }
}
